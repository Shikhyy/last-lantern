{
  "name": "the-last-lantern",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Last Lantern — a browser-first social deduction drama set in the fictional palace of Nimbagarh.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "assets:optimize": "node scripts/optimize-models.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "size": "node scripts/size-budget.mjs",
    "posters": "node scripts/capture-posters.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.1",
    "@fontsource/public-sans": "^5.1.1",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.0.4",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.0.4",
    "gsap": "^3.15.0",
    "postprocessing": "^6.36.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@gltf-transform/cli": "^4.1.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
